# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Port configuration
PORT=3000

# Authentication & Security
# Required in production; generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Demo seed data is available only when NODE_ENV=development and this is true.
VOXMITRA_DEMO_MODE=false

# Database backend (JSON is the local-development default)
VOXMITRA_DATABASE=json
# Server-only PostgreSQL connection string. Never use a browser-exposed variable.
DATABASE_URL=""
# Optional path to the Supabase database root CA certificate for verified TLS.
DATABASE_CA_CERT_PATH=""

# ElevenLabs Conversational AI & Voice Integration (Required for live voice synthesis)
ELEVENLABS_API_KEY=""

# Exotel AgentStream Voicebot applet credentials for the inbound media WebSocket.
EXOTEL_ACCOUNT_SID=""
EXOTEL_API_KEY=""
EXOTEL_API_TOKEN=""
EXOTEL_SUBDOMAIN="api.exotel.com"
EXOTEL_CALLER_ID=""
EXOTEL_STREAM_USERNAME=""
EXOTEL_STREAM_PASSWORD=""

# Optional Gemini Live model and prebuilt voice overrides.
GEMINI_LIVE_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"
GEMINI_LIVE_VOICE="Aoede"

# Razorpay provider values are not used while recharge and mandate routes are disabled.
# VoxMitra is owned by Ramachandra Naidu Jyothi Private Limited
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
